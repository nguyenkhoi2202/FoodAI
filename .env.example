# Google Gemini API Key (Lấy tại https://aistudio.google.com/app/apikey)
# Mẹo chống quá tải & nhân hạn mức: Có thể nhập nhiều key cách nhau bằng dấu phẩy (key1,key2,...)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình Google Gemini (Khuyên dùng gemini-3.1-flash-lite để siêu tốc, ít token & ít lỗi nhất)
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
